{
  "name": "maildotnull",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": "github:maildotnull/maildotnull",
  "homepage": "https://github.com/maildotnull/maildotnull",
  "scripts": {
    "dev": "vite",
    "build": "vite build && go build -trimpath -ldflags=\"-s -w\" -o dist/maildotnull .",
    "start": "./dist/maildotnull",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && go vet ./..."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@12.16.1"
}
